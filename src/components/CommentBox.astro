---
// @ts-nocheck  
type Props = {
  repo: string;
};

const { repo } = Astro.props;

---

<section class="block h-fit" id="blog-comments">
  <script
    is:inline
    src="https://utteranc.es/client.js"
    repo={repo}
    issue-term="pathname"
    theme="preferred-color-scheme"
    crossorigin="anonymous"
    async></script>
</section>

<style is:global>
  #blog-comments .utterances {
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
  }
</style>
