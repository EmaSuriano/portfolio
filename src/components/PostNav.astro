---
import GithubSlugger from "github-slugger";
import type { CollectionEntry } from "astro:content";
import { extractMarkdownTitles } from "helpers";

type Props = { entry: CollectionEntry<"blog"> };

const slugs = new GithubSlugger();

const { body } = Astro.props.entry;

const titles = extractMarkdownTitles(body ?? "").map(({ level, title }) => ({
  pad: level <= 2 ? "pl-3" : level === 3 ? "pl-5" : "pl-7",
  title,
  slug: slugs.slug(title),
}));
---

{
  titles.length > 0 && (
    <nav
      id="blog-navigation"
      class="sticky top-24 hidden self-start pt-6 transition-opacity lg:block"
      aria-label="On this page"
    >
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">
        On this page
      </p>
      <ol class="m-0 list-none border-l border-slate-200 p-0 dark:border-slate-700">
        {titles.map(({ title, pad, slug }) => (
          <li>
            <a
              href={`#${slug}`}
              data-slug={slug}
              class={`-ml-px block border-l-2 border-transparent py-1 text-sm text-slate-500 transition-colors hover:border-slate-400 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 ${pad}`}
            >
              {title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  a {
    text-decoration: none;
  }

  a[aria-current="location"] {
    border-left-color: theme(colors.indigo.500);
    color: theme(colors.indigo.700);
    font-weight: 600;
    background-color: theme(colors.indigo.50);
    border-radius: 0 0.25rem 0.25rem 0;
  }

  @media (prefers-color-scheme: dark) {
    a[aria-current="location"] {
      border-left-color: theme(colors.indigo.400);
      color: theme(colors.indigo.300);
      background-color: rgb(99 102 241 / 0.18);
    }
  }
</style>

<script>
  const nav = document.querySelector("#blog-navigation");
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a[data-slug]")];
    const headings = links
      .map((link) => document.getElementById(link.dataset.slug ?? ""))
      .filter((node): node is HTMLElement => node instanceof HTMLElement);

    const setCurrent = (id: string) => {
      for (const link of links) {
        if (link.dataset.slug === id) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    const onScroll = () => {
      const line = 128;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= line) {
          current = heading;
        }
      }
      if (current) setCurrent(current.id);
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("hashchange", onScroll);

    const comments = document.querySelector("#blog-comments");
    if (comments) {
      const hide = new IntersectionObserver((entries) => {
        const hidden = Boolean(entries[0]?.isIntersecting);
        nav.classList.toggle("opacity-0", hidden);
        nav.classList.toggle("pointer-events-none", hidden);
      });
      hide.observe(comments);
    }
  }
</script>
