---

---

<section class="prose prose-lg max-w-none dark:prose-dark">
  <slot />
</section>

<script>
  import mediumZoom from "medium-zoom/dist/pure";
  import "medium-zoom/dist/style.css";
  import "@justinribeiro/lite-youtube";

  let zoom: ReturnType<typeof mediumZoom> | undefined;
  let abort: AbortController | undefined;

  const init = () => {
    abort?.abort();
    abort = new AbortController();

    zoom?.detach();
    const images = document.querySelectorAll<HTMLElement>(
      "[data-zoomable] > img, article section figure > img, [id^='mermaid-']",
    );
    zoom = mediumZoom(images, {
      margin: 0,
      scrollOffset: 0,
      background:
        window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "#171717"
          : "#fff",
    });

    const videos = document.querySelectorAll("lite-youtube");
    videos.forEach((node) => {
      if (node.nextElementSibling?.tagName === "FIGCAPTION") return;
      const label = document.createElement("figcaption");
      label.textContent = node.videoTitle;
      node.parentNode?.insertBefore(label, node.nextSibling);
    });

    if (window.location.hash) {
      const target = document.querySelector(window.location.hash);
      target?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  };

  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  .medium-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    @apply bg-white dark:bg-neutral-900 !important;
  }

  .medium-zoom-image {
    @apply rounded-md;
  }

  .medium-zoom-image--opened {
    z-index: 101;
    max-width: 100vw !important;
    max-height: 100vh !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain;
  }
</style>
